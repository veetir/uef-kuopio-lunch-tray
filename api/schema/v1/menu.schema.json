{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunch.veeti.dev/schema/v1/menu.schema.json",
  "title": "Restaurant menu",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "apiVersion",
    "schemaVersion",
    "restaurant",
    "requestedLanguage",
    "contentLanguage",
    "date",
    "service",
    "offers",
    "groups",
    "freshness"
  ],
  "properties": {
    "apiVersion": { "const": "v1" },
    "schemaVersion": { "const": 1 },
    "restaurant": { "$ref": "#/$defs/restaurant" },
    "requestedLanguage": { "$ref": "#/$defs/language" },
    "contentLanguage": { "$ref": "#/$defs/language" },
    "date": { "$ref": "#/$defs/date" },
    "service": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["serving", "closed", "noMenu", "unknown"]
        },
        "hours": { "type": "string", "minLength": 1 }
      }
    },
    "closure": { "$ref": "#/$defs/closure" },
    "offers": {
      "type": "array",
      "items": { "$ref": "#/$defs/offer" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": true,
      "required": ["fetchedAt", "isStale"],
      "properties": {
        "fetchedAt": { "type": "string", "format": "date-time" },
        "isStale": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "language": { "enum": ["fi", "en"] },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": true,
      "required": ["fi", "en"],
      "properties": {
        "fi": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "startsOn", "endsOn"],
      "properties": {
        "kind": { "enum": ["seasonal", "exceptional"] },
        "startsOn": { "$ref": "#/$defs/date" },
        "endsOn": { "$ref": "#/$defs/date" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "catalogClosure": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "startsOn", "endsOn"],
      "properties": {
        "kind": { "enum": ["seasonal", "exceptional"] },
        "startsOn": { "$ref": "#/$defs/date" },
        "endsOn": { "$ref": "#/$defs/date" },
        "reason": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "fi": { "type": "string" },
            "en": { "type": "string" }
          }
        }
      }
    },
    "restaurant": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "order",
        "name",
        "websiteUrl",
        "languages",
        "closures"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "name": { "$ref": "#/$defs/localizedText" },
        "websiteUrl": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/language" }
        },
        "closures": {
          "type": "array",
          "items": { "$ref": "#/$defs/catalogClosure" }
        }
      }
    },
    "price": {
      "type": "object",
      "additionalProperties": true,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "currency": { "const": "EUR" },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["student", "staff", "guest"] }
        }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label", "price"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "price": { "$ref": "#/$defs/price" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "nutrition": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "amount", "unit"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "amount": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "ingredients": { "type": "string", "minLength": 1 },
        "nutritionPer100g": {
          "type": "array",
          "items": { "$ref": "#/$defs/nutrition" }
        },
        "co2eKilogramsPer100Grams": { "type": "number", "minimum": 0 },
        "diets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "recipe": { "$ref": "#/$defs/recipe" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "prices", "items", "sortOrder"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "prices": {
          "type": "array",
          "items": { "$ref": "#/$defs/price" }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/item" }
        },
        "sortOrder": { "type": "integer" }
      }
    }
  }
}
