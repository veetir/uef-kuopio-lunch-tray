{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunch.veeti.dev/schema/v1/snapshot.schema.json",
  "title": "UEF Kuopio Lunch API daily snapshot",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "apiVersion",
    "schemaVersion",
    "revision",
    "requestedLanguage",
    "date",
    "restaurants",
    "menus"
  ],
  "properties": {
    "apiVersion": {
      "const": "v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "requestedLanguage": {
      "enum": ["fi", "en"]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "restaurants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "restaurants.schema.json#/$defs/restaurant"
      }
    },
    "menus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "menu.schema.json"
      }
    }
  }
}
